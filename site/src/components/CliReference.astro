---
/**
 * Copy to site/src/components/CliReference.astro
 * Richer-than-markdown CLI reference: filterable list + structured details.
 */
import type { CliCatalog } from '../lib/cli-describe';

interface Props {
  catalog: CliCatalog;
  base?: string;
}

const { catalog, base = '/toolbox' } = Astro.props;
const { commands, mcpTools } = catalog;
---

<section class="cli-ref" data-cli-ref>
  <label class="cli-ref__search">
    <span class="sr-only">Filter commands</span>
    <input
      type="search"
      placeholder="Filter commands…"
      data-cli-filter
      autocomplete="off"
    />
  </label>

  <p class="cli-ref__count" data-cli-count>
    {commands.length} commands
  </p>

  <ul class="cli-ref__list" role="list">
    {
      commands.map((cmd) => (
        <li
          class="cli-ref__item"
          data-cli-item
          data-name={cmd.name.toLowerCase()}
          data-about={(cmd.about ?? '').toLowerCase()}
          data-mcp={(cmd.mcpTool ?? '').toLowerCase()}
        >
          <a class="cli-ref__link" href={`#${cmd.slug}`}>
            <code>toolbox {cmd.name}</code>
            {cmd.mcpTool && <span class="cli-ref__badge">MCP {cmd.mcpTool}</span>}
          </a>
          {cmd.about && <p class="cli-ref__about">{cmd.about}</p>}
        </li>
      ))
    }
  </ul>

  <h2 id="mcp-tools">MCP tools</h2>
  <p>
    Built-in MCP tools share the same authorization path as the CLI. Agent loop: <a
      href={`${base}/agents/reads/`}>Read the catalog from an agent</a
    >.
  </p>
  <div class="cli-ref__table-wrap">
    <table>
      <thead>
        <tr>
          <th>MCP tool</th>
          <th>CLI</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {
          mcpTools.map((t) => (
            <tr>
              <td><code>{t.name}</code></td>
              <td>
                {t.cliCommands.length
                  ? t.cliCommands.map((c) => <code class="cli-ref__cli">{c}</code>)
                  : '—'}
              </td>
              <td>{t.description ?? '—'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="command-details">Command details</h2>
  {
    commands.map((cmd) => (
      <article class="cli-ref__detail" id={cmd.slug}>
        <h3><code>toolbox {cmd.name}</code></h3>
        {cmd.about && <p>{cmd.about}</p>}
        {cmd.usage && (
          <p class="cli-ref__usage">
            <span class="cli-ref__label">Usage</span>
            <code>{cmd.usage}</code>
          </p>
        )}
        {cmd.mcpTool && (
          <p>
            <span class="cli-ref__label">MCP</span>
            <code>{cmd.mcpTool}</code>
          </p>
        )}
        {cmd.args.length > 0 && (
          <div class="cli-ref__table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Argument</th>
                  <th>Kind</th>
                </tr>
              </thead>
              <tbody>
                {cmd.args.map((a) => (
                  <tr>
                    <td>
                      <code>{a.long ? `--${a.long}` : a.name}</code>
                    </td>
                    <td>{a.positional ? 'positional' : 'flag'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {cmd.helpText && (
          <details class="cli-ref__raw">
            <summary>Raw <code>--help</code></summary>
            <pre><code>{cmd.helpText}</code></pre>
          </details>
        )}
      </article>
    ))
  }
</section>

<style>
  .cli-ref {
    --cli-border: color-mix(in srgb, var(--sl-color-gray-5) 80%, transparent);
    display: grid;
    gap: 1.25rem;
  }
  .cli-ref__search input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--cli-border);
    border-radius: 0.4rem;
    background: var(--sl-color-gray-7, #111);
    color: inherit;
    font: inherit;
  }
  .cli-ref__count {
    margin: 0;
    opacity: 0.75;
    font-size: 0.9rem;
  }
  .cli-ref__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .cli-ref__item {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--cli-border);
  }
  .cli-ref__link {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    text-decoration: none;
  }
  .cli-ref__badge {
    font-size: 0.75rem;
    opacity: 0.8;
    border: 1px solid var(--cli-border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.4rem;
  }
  .cli-ref__about {
    margin: 0.35rem 0 0;
    opacity: 0.85;
  }
  .cli-ref__table-wrap {
    overflow-x: auto;
  }
  .cli-ref__cli + .cli-ref__cli::before {
    content: ', ';
  }
  .cli-ref__detail {
    padding: 1.25rem 0;
    border-top: 1px solid var(--cli-border);
  }
  .cli-ref__label {
    display: inline-block;
    min-width: 4.5rem;
    opacity: 0.7;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .cli-ref__usage code {
    white-space: pre-wrap;
  }
  .cli-ref__raw {
    margin-top: 0.75rem;
  }
  .cli-ref__raw pre {
    overflow-x: auto;
    padding: 0.75rem;
    border-radius: 0.35rem;
    background: var(--sl-color-gray-6, #1a1a1a);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
  .cli-ref__item[hidden] {
    display: none;
  }
</style>

<script>
  const root = document.querySelector('[data-cli-ref]');
  if (root) {
    const input = root.querySelector('[data-cli-filter]');
    const items = [...root.querySelectorAll('[data-cli-item]')];
    const count = root.querySelector('[data-cli-count]');
    const total = items.length;
    input?.addEventListener('input', () => {
      const q = (input as HTMLInputElement).value.trim().toLowerCase();
      let shown = 0;
      for (const el of items) {
        const hay = `${el.getAttribute('data-name')} ${el.getAttribute('data-about')} ${el.getAttribute('data-mcp')}`;
        const match = !q || hay.includes(q);
        (el as HTMLElement).hidden = !match;
        if (match) shown++;
      }
      if (count) count.textContent = q ? `${shown} of ${total} commands` : `${total} commands`;
    });
  }
</script>
