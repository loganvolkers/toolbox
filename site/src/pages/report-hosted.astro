---
// Host page for the Toolbox report. The element and the data come from
// `toolbox report -o web`. This page only fills the header, nav, and footer slots.
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Toolbox report</title>
    <style>
      body {
        margin: 0;
        background: #fbfbfa;
        color: #1d1d1b;
        font: 15px/1.5 system-ui, sans-serif;
      }
      a { color: #2f5d8a; }
      header, nav, footer {
        max-width: 1100px;
        margin: 0 auto;
        padding: 12px 16px 0;
      }
      header, nav { display: flex; gap: 16px; }
      footer { color: #6b6b66; font-size: 13px; padding-bottom: 24px; }
      @media (prefers-color-scheme: dark) {
        body { background: #161615; color: #ecebe7; }
        a { color: #86b3e0; }
        footer { color: #a3a29c; }
      }
    </style>
  </head>
  <body>
    <toolbox-report src="/toolbox/report/report.json">
      <header slot="header">
        <a href="/toolbox/">Toolbox</a>
        <a href="/toolbox/demo/report/">About this report</a>
      </header>
      <nav slot="nav" aria-label="Site">
        <a href="/toolbox/concepts/scorecards/">Scorecards</a>
        <a href="/toolbox/start/run/">Run it locally</a>
      </nav>
      <footer slot="footer">
        <p>Scores for this commit, from <code>toolbox report</code>. The test runner and the GitHub API are skipped.</p>
      </footer>
    </toolbox-report>
    <script is:inline src="/toolbox/report/toolbox-report.js"></script>
  </body>
</html>
