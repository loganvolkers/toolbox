+def dependabot_dir_state(repo, eco, d):
+    """'missing', 'empty' (no manifest for eco there) or 'ok'. Globs and unknown ecosystems count as ok."""
+    if "*" in d or eco not in ECO_FILES:
+        return "ok"
+    p = d.strip("/")
+    if p and not any(f == p or f.startswith(p + "/") for f in repo.files):
+        return "missing"
+    rx = re.compile(r"^%s(%s)$" % (re.escape(p + "/") if p else "", ECO_FILES[eco]))
+    return "ok" if any(rx.match(f) for f in repo.files) else "empty"
+
