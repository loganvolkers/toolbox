+def jobs_without_permissions(text):
+    """Names of jobs that declare no job-level `permissions:` (None if no `jobs:` block was parsed)."""
+    m = re.search(r"^jobs\s*:\s*$", text, re.M)
+    if not m:
+        return None
+    jobs, cur, ind = [], None, None
+    for ln in text[m.end():].splitlines():
+        if not ln.strip() or ln.lstrip().startswith("#"):
+            continue
+        i = len(ln) - len(ln.lstrip())
+        if i == 0:
+            break
+        if ind is None:
+            ind = i
+        if i == ind:
+            cur = [ln.strip().split(":")[0].strip("'\""), False, None]
+            jobs.append(cur)
+        elif cur is not None and i > ind:
+            if cur[2] is None:
+                cur[2] = i
+            if i == cur[2] and re.match(r"\s*permissions\s*:", ln):
+                cur[1] = True
+    return [j[0] for j in jobs if not j[1]] if jobs else None
+
