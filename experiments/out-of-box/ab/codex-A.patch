new file mode 100644
index 0000000..23a7d31
--- /dev/null
+++ b/.github/zizmor.yml
@@ -0,0 +1,24 @@
+# zizmor configuration. Each ignore below is deliberate; keep the reason current.
+rules:
+  # Local composite actions are referenced as `./.github/actions/<name>` so they run
+  # from the same checkout as the workflow (including PR heads). Switching to the
+  # self-repository syntax would change which revision of the action is used, so
+  # keep the relative form until that migration is planned.
+  self-repository:
+    ignore:
+      - bazel.yml
+      - rust-ci-full-nextest-platform.yml
+      - rust-ci-full.yml
+      - rust-ci.yml
+      - rust-release-windows.yml
+      - rust-release.yml
+      - rusty-v8-release.yml
+      - sdk.yml
+      - v8-canary.yml
+  # Release publishing uses the SHA-pinned softprops/action-gh-release for its
+  # asset globbing, prerelease and overwrite handling; replacing it with raw
+  # `gh release` calls is a separate change to the release process.
+  superfluous-actions:
+    ignore:
+      - rust-release.yml
+      - rusty-v8-release.yml
