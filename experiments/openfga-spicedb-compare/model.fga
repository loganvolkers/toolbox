model
  schema 1.1

type user

type group
  relations
    define member: [user]

type folder
  relations
    define owner: [group]
    define parent: [folder]
    define viewer: [user] or member from owner or viewer from parent

type document
  relations
    define folder: [folder]
    define owner: [user]
    define viewer: [user, user:*] or owner or viewer from folder
