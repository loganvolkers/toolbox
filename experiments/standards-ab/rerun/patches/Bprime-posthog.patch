@@ -0,0 +1,60 @@
+# A Toolbox package (D89): occurrences of a pattern, ratcheted per file, with a campaign to zero
+# (D01M7Z2ZZ97VZQNTDT4QQHM3HQD).
+apiVersion: toolbox.dev/package/v0
+name: pattern-count
+version: 0.1.0
+description: >-
+  Every match of a regular expression is a violation. The ratchet fails a
+  pull request that adds a match to any file, and a campaign pays the
+  matches down to zero.
+parameters:
+  name:
+    type: string
+    default: pattern-count
+    description: >-
+      Names this standard's connector, scorecard and campaign. Include the
+      package again with another name (and kind) for a second pattern.
+  kind:
+    type: string
+    default: PatternFile
+    description: The entity kind for scanned files (PascalCase; unique per include).
+  title:
+    type: string
+    default: No matches of the pattern
+    description: The scorecard's heading.
+  owner:
+    type: string
+    default: group:maintainers
+    description: Who owns the standard.
+  root:
+    type: string
+    default: .
+    description: >-
+      The checkout the files are read from, relative to where `toolbox report`
+      runs.
+  files:
+    type: array
+    description: Globs of the files scanned, e.g. ["**/*.py"]. `**` spans directories.
+  exclude:
+    type: array
+    default: []
+    description: >-
+      Globs never scanned: tests, migrations, vendored code, e.g.
+      ["**/tests/**", "**/test_*.py"].
+  exempt:
+    type: object
+    default: {}
+    description: >-
+      Files scanned but exempt, path → reason, e.g. {"app/models/util.py":
+      "the routed helpers themselves"}. They are skipped by the scorecard and
+      listed here with why.
+  pattern:
+    type: string
+    description: >-
+      The regular expression (Rust regex syntax), e.g.
+      '\bconsole\.(log|debug)\('. Each match is one violation.
+  fix:
+    type: string
+    default: Remove the match, using the alternative the standard names.
+    description: What to do about a violation (shown with each one).
+fragments: [fragments/*.yaml]
