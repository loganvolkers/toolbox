new file mode 100644
index 00000000..154420e5
--- /dev/null
+++ b/.github/workflows/ci-toolbox-standards.yml
@@ -0,0 +1,62 @@
+name: Toolbox standards (S1 person ORM ratchet)
+
+# Gate for .toolbox/STANDARD.md (S1: no direct ORM queries on person tables). Fails a pull request that
+# adds a direct `Person.objects` / `PersonDistinctId.objects` / `CohortPeople.objects` / `Group.objects` /
+# `GroupTypeMapping.objects` query outside the routed helpers, the person model module and tests, against the committed baseline .toolbox/results.json. Fewer violations pass
+# and are listed as "better", so the baseline can be tightened with --update.
+
+on:
+    pull_request:
+        paths:
+            - '**/*.py'
+            - .toolbox/**
+            - .github/workflows/ci-toolbox-standards.yml
+
+concurrency:
+    group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
+    cancel-in-progress: true
+
+permissions:
+    contents: read
+
+env:
+    TOOLBOX_GIT: https://github.com/loganvolkers/toolbox
+    TOOLBOX_TAG: v0.1.1
+
+jobs:
+    person-orm-ratchet:
+        runs-on: ubuntu-latest
+        timeout-minutes: 30
+        steps:
+            - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+              with:
+                  persist-credentials: false
+
+            - name: Install Rust
+              uses: dtolnay/rust-toolchain@3c5f7ea28cd621ae0bf5283f0e981fb97b8a7af9
+              with:
+                  toolchain: stable
+
+            - name: Install toolbox (pinned tag, built from source)
+              run: |
+                  set -euo pipefail
+                  cargo install --locked --git "$TOOLBOX_GIT" --tag "$TOOLBOX_TAG" --root "$RUNNER_TEMP/toolbox" toolbox-cli toolbox-connector-workspace
+                  echo "$RUNNER_TEMP/toolbox/bin" >> "$GITHUB_PATH"
+
+            - name: Gate (ratchet against .toolbox/results.json)
+              run: |
+                  set -uo pipefail
+                  toolbox --version
+                  toolbox report .toolbox --baseline .toolbox/results.json -o failures --out /dev/null --verdict "$RUNNER_TEMP/verdict.json" 2> "$RUNNER_TEMP/gate.txt"
+                  rc=$?
+                  cat "$RUNNER_TEMP/gate.txt"
+                  {
+                      echo "## S1: no direct ORM queries on person tables"
+                      echo
+                      echo '```'
+                      grep -v '^· changed' "$RUNNER_TEMP/gate.txt" || true
+                      echo '```'
+                      echo
+                      echo "See .toolbox/STANDARD.md for how to fix a regression or tighten the baseline."
+                  } >> "$GITHUB_STEP_SUMMARY"
+                  exit $rc
