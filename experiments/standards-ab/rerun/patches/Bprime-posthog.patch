@@ -0,0 +1,30 @@
+# PostHog repo portal (Toolbox). Enforces S1 from AGENTS.md: no new direct ORM queries on the person
+# tables. See .toolbox/STANDARD.md for the commands. Run every command from the repository root.
+apiVersion: toolbox.dev/v1alpha1
+portal:
+  name: posthog
+  title: PostHog repository standards
+  owner: group:maintainers
+  toolbox: "0.1"
+include:
+  # Vendored copy of Toolbox's packages/pattern-count (v0.1.0), so CI needs no network.
+  - package: ./packages/pattern-count
+    with:
+      name: person-orm
+      kind: PythonFile
+      title: No direct ORM queries on person tables (S1)
+      files: ["**/*.py"]
+      exclude:
+        - "**/test/**"
+        - "**/tests/**"
+        - "**/test_*.py"
+        - "**/*_test.py"
+        - "**/conftest.py"
+      exempt:
+        posthog/models/person/util.py: the routed person helpers themselves
+        posthog/models/group_type_mapping.py: routed helper allowed to query these tables
+        posthog/models/person/person.py: the model module; its managers back the routed helpers
+      pattern: '\b(Person|PersonDistinctId|CohortPeople|Group|GroupTypeMapping)\.objects\b'
+      fix: >-
+        Use the routed helpers in posthog/models/person/util.py (or add a new one
+        there following the established pattern) instead of a direct ORM query.
