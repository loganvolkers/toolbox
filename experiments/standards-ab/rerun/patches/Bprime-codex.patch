+# A Toolbox package (D89): a size limit on files, ratcheted per file, with a campaign to zero
+# (D01M7Z2ZZ97VZQNTDT4QQHM3HQD).
+apiVersion: toolbox.dev/package/v0
+name: file-size
+version: 0.1.0
+description: >-
+  Files over a line limit are violations. The ratchet fails a pull request
+  that grows a violating file or brings a new one over the limit, and a
+  campaign pays the excess down.
+parameters:
+  name:
+    type: string
+    default: file-size
+    description: >-
+      Names this standard's connector, scorecard, rule prefix and campaign.
+      Include the package again with another name (and kind) for a second size
+      standard.
+  kind:
+    type: string
+    default: SizedFile
+    description: The entity kind for measured files (PascalCase; unique per include).
+  title:
+    type: string
+    default: Files within the size limit
+    description: The scorecard's heading.
+  owner:
+    type: string
+    default: group:maintainers
+    description: Who owns the standard.
+  root:
+    type: string
+    default: .
+    description: >-
+      The checkout the files are read from, relative to where `toolbox report`
+      runs.
+  files:
+    type: array
+    description: >-
+      Globs of the files measured, e.g. ["src/**/*.rs"]. `**` spans
+      directories.
+  exclude:
+    type: array
+    default: []
+    description: >-
+      Globs never measured: tests, generated or vendored code, e.g.
+      ["**/tests/**", "**/*_test.go"].
+  exempt:
+    type: object
+    default: {}
+    description: >-
+      Files measured but exempt, path → reason, e.g. {"src/generated.rs":
+      "generated by build.rs"}. They are skipped by the scorecard and listed
+      here with why.
+  limit:
+    type: integer
+    tighten: lower
+    description: A file with more lines than this is a violation.
+  fix:
+    type: string
+    default: >-
+      Move code out of this file into new modules until it is within the
+      limit. Do not add new functionality to it.
+    description: What to do about a violation (shown with each one).
+fragments: [fragments/*.yaml]
