+# Ratchet for the "small Rust modules" standard (AGENTS.md). See .toolbox/STANDARD.md.
+# Fails when a .rs file under codex-rs/ that is already over 700 lines grows, or when a file
+# crosses 700 lines. Shrinking files pass and are listed so the baseline can be tightened.
+---
+name: rust-module-size
+
+on:
+  pull_request:
+    branches: [main]
+
+permissions:
+  contents: read
+
+env:
+  TOOLBOX_VERSION: "0.1.1"
+  TOOLBOX_REPO: loganvolkers/toolbox
+  TOOLBOX_TARGET: x86_64-unknown-linux-gnu
+
+jobs:
+  gate:
+    name: Rust module size ratchet
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          persist-credentials: false
+
+      - name: Install toolbox
+        shell: bash
+        run: |
+          set -euo pipefail
+          dir="$RUNNER_TEMP/toolbox-bin"
+          mkdir -p "$dir" "$RUNNER_TEMP/toolbox-dl"
+          cd "$RUNNER_TEMP/toolbox-dl"
+          base="https://github.com/${TOOLBOX_REPO}/releases/download/v${TOOLBOX_VERSION}"
+          for app in toolbox-cli toolbox-connector-workspace; do
+            archive="${app}-${TOOLBOX_TARGET}.tar.xz"
+            curl -fsSLO "${base}/${archive}"
+            curl -fsSLO "${base}/${archive}.sha256"
+            sha256sum -c "${archive}.sha256"
+            tar -xJf "${archive}"
+            cp "${app}-${TOOLBOX_TARGET}"/* "$dir"/
+          done
+          echo "$dir" >> "$GITHUB_PATH"
+
+      - name: Gate (ratchet against .toolbox/results.json)
+        shell: bash
+        run: |
+          toolbox --version
+          toolbox report .toolbox --baseline .toolbox/results.json --out /dev/null
