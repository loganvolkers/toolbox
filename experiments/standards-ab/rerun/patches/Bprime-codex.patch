+# Toolbox repo portal for this repository: enforces the written standard
+# "small Rust modules" (S2) from AGENTS.md. See .toolbox/STANDARD.md.
+apiVersion: toolbox.dev/v1alpha1
+portal:
+  name: codex
+  title: Codex repository standards
+  owner: group:maintainers
+  toolbox: "0.1"
+include:
+  # Vendored copy of Toolbox's file-size package (no network needed).
+  - package: packages/file-size
+    with:
+      name: rust-module-size
+      kind: RustModule
+      title: Rust modules within 700 lines
+      files: ["codex-rs/**/*.rs"]
+      # Test files are exempt from the standard.
+      exclude: ["**/tests/**", "**/tests.rs", "**/*_tests.rs"]
+      # Files measured but exempt from the limit: path -> reason.
+      exempt: {}
+      limit: 700
+      fix: >-
+        Target Rust modules under 500 LoC, excluding tests. Do not add new
+        functionality to this file; add it in a new module, and move code out
+        until the file is at most 700 lines.
