@@ -0,0 +1,53 @@
+# Enforces coding standards recorded in .seikika/ (see .seikika/STANDARD.md).
+# S1: no new direct ORM queries on person tables; existing ones are ratcheted down.
+name: Seikika standards
+
+on:
+  pull_request:
+  push:
+    branches: [master]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: seikika-standards-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  s1-person-orm:
+    name: S1 person-table ORM ratchet
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          persist-credentials: false
+
+      # Installs released, checksum-verified seikika binaries and runs Seikika's own ratchet
+      # (`check` mode: fail on regressions only; a stale baseline is reported, not failed).
+      # It annotates the PR with each file whose violation count grew and uploads the HTML report.
+      - name: Seikika report (ratchet)
+        # TODO(platform): pin to the commit SHA of v0.1.1, as the other workflows here pin actions.
+        uses: seikika/seikika/actions/report@v0.1.1
+        with:
+          seikika-version: "0.1.1"
+          portal: .seikika
+          baseline: .seikika/results.json
+          mode: check
+
+      # The S1 gate: the ratchet above plus new files with violations (which Seikika reports
+      # as a change, not a regression). Also says when the baseline can be tightened.
+      - name: S1 gate
+        if: always()
+        run: |
+          export PATH="$RUNNER_TEMP/seikika-bin:$PATH"
+          .seikika/s1.sh gate
+
+      - name: S1 campaign progress
+        if: always()
+        run: |
+          export PATH="$RUNNER_TEMP/seikika-bin:$PATH"
+          { echo '### S1 campaign: person-table ORM queries to zero'; echo '```json'
+            .seikika/s1.sh campaign; echo '```'; } | tee -a "$GITHUB_STEP_SUMMARY"
