diff --git a/.seikika/s1.sh b/.seikika/s1.sh
new file mode 100755
index 00000000..361c6de4
--- /dev/null
+++ b/.seikika/s1.sh
@@ -0,0 +1,98 @@
+#!/usr/bin/env bash
+# S1 (no direct ORM queries on person tables): report, gate, campaign and baseline update.
+# The rule itself lives in .seikika/seikika.yaml and is scored by `seikika report`; this script
+# only runs it and shapes the output. Run from the repository root. See .seikika/STANDARD.md.
+#
+#   .seikika/s1.sh report     every violation by file, as JSON [{"file", "count"}]
+#   .seikika/s1.sh gate       exit 1 on a violation the baseline doesn't allow; says what went down
+#   .seikika/s1.sh campaign   baseline (campaign start) count, current count, percent done
+#   .seikika/s1.sh update     record improvements in .seikika/results.json (refuses on regressions)
+#   .seikika/s1.sh campaign-start   once per campaign: record its starting point
+set -euo pipefail
+
+PORTAL=.seikika
+BASELINE=.seikika/results.json
+CARD=person-orm
+RULE=no-direct-person-orm
+START=.seikika/s1-campaign-start.json
+
+command -v seikika >/dev/null || { echo "seikika not on PATH" >&2; exit 2; }
+command -v jq >/dev/null || { echo "jq not on PATH" >&2; exit 2; }
+[ -f "$PORTAL/seikika.yaml" ] || { echo "run from the repository root ($PORTAL/seikika.yaml not found)" >&2; exit 2; }
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# {"file": count} for a seikika-report/v1 document (a report or the baseline).
+by_file='(.results[$card] // {}) | to_entries
+  | map(select(.value.failing[$rule] != null)
+        | {file: (.key | ltrimstr("file:")), count: .value.failing[$rule]})
+  | sort_by(-.count, .file)'
+
+case "${1:-}" in
+  report)
+    seikika report "$PORTAL" -o json --out "$tmp/current.json" >/dev/null
+    jq --arg card "$CARD" --arg rule "$RULE" "$by_file" "$tmp/current.json"
+    ;;
+
+  gate)
+    rc=0
+    # Seikika's ratchet: more violations in a file than recorded is a regression (exit 1).
+    seikika report "$PORTAL" --baseline "$BASELINE" --verdict "$tmp/verdict.json" \
+      -o json --out "$tmp/current.json" >"$tmp/ratchet.log" 2>&1 || rc=$?
+    grep -E '^(✗|✓|·|baseline:)' "$tmp/ratchet.log" || true
+    [ -f "$tmp/verdict.json" ] || { cat "$tmp/ratchet.log" >&2; exit 2; }
+    # Seikika reports a new failing entity as a change, not a regression, so files the baseline
+    # does not record as violating (new files, files that were passing or exempt) are checked here.
+    jq -n --arg card "$CARD" --arg rule "$RULE" \
+      --slurpfile b "$BASELINE" --slurpfile c "$tmp/current.json" '
+      ($b[0].results[$card] // {}) as $base
+      | ($c[0].results[$card] // {}) | to_entries
+      | map(select(.value.failing[$rule] != null and ($base[.key].failing[$rule] == null)))
+      | .[] | "✗ new     \(.key | ltrimstr("file:")): \(.value.failing[$rule]) violation(s), none allowed"
+      ' -r >"$tmp/new.txt"
+    if [ -s "$tmp/new.txt" ]; then cat "$tmp/new.txt"; rc=1; fi
+    if [ "$(jq '.improvements | length' "$tmp/verdict.json")" -gt 0 ]; then
+      echo "S1 violations went down. Tighten the baseline: .seikika/s1.sh update, then commit $BASELINE"
+    fi
+    if [ "$rc" -ne 0 ]; then
+      echo "S1 gate FAILED: direct Person/PersonDistinctId/CohortPeople/Group/GroupTypeMapping .objects queries added." \
+        "Use the routed helpers in posthog/models/person/util.py (see .seikika/STANDARD.md)."
+    else
+      echo "S1 gate passed."
+    fi
+    exit "$rc"
+    ;;
+
+  campaign)
+    # Progress is measured from the campaign's start (.seikika/s1-campaign-start.json, written once
+    # when the campaign began), not from results.json, which tightens with every fix.
+    seikika report "$PORTAL" -o json --out "$tmp/current.json" >/dev/null
+    jq -n --arg card "$CARD" --arg rule "$RULE" \
+      --slurpfile s "$START" --slurpfile c "$tmp/current.json" "
+      (\$c[0] | $by_file) as \$cf
+      | (\$s[0].files | map(.count) | add // 0) as \$base
+      | (\$cf | map(.count) | add // 0) as \$cur
+      | {campaign: \"person-orm-zero\", started: \$s[0].started,
+         baseline: \$base, current: \$cur,
+         baselineFiles: (\$s[0].files | length), currentFiles: (\$cf | length),
+         percentDone: (if \$base == 0 then 100 else (((\$base - \$cur) * 1000 / \$base) | round) / 10 end)}"
+    ;;
+
+  campaign-start)
+    # Once, when a campaign begins: record today's violations as its starting point.
+    seikika report "$PORTAL" -o json --out "$tmp/current.json" >/dev/null
+    jq --arg card "$CARD" --arg rule "$RULE" --arg today "$(date -u +%F)" \
+      "{started: \$today, files: ($by_file)}" "$tmp/current.json" >"$START"
+    echo "wrote $START"
+    ;;
+
+  update)
+    seikika report "$PORTAL" --baseline "$BASELINE" --update -o json --out "$tmp/current.json"
+    ;;
+
+  *)
+    sed -n '2,10p' "$0" >&2
+    exit 2
+    ;;
+esac
