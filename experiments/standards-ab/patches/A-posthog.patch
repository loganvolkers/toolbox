+name: Standards (S1 person ORM ratchet)
+
+on:
+    pull_request:
+
+permissions:
+    contents: read
+
+jobs:
+    s1-person-orm-gate:
+        name: S1 no new direct ORM queries on person tables
+        runs-on: ubuntu-24.04
+        timeout-minutes: 5
+        steps:
+            - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+              with:
+                  persist-credentials: false
+
+            - name: Gate
+              run: python3 .standards/s1_person_orm.py gate
+
+            - name: Campaign progress
+              if: always()
+              run: python3 .standards/s1_person_orm.py campaign | tee -a "$GITHUB_STEP_SUMMARY"
