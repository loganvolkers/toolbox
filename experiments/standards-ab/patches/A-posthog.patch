index 00000000..bd819cc9
--- /dev/null
+++ b/.standards/s1_person_orm.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""S1: no direct ORM queries on person tables.
+
+Ratchet for the AGENTS.md rule that forbids new direct Django ORM queries
+(`<Model>.objects...`) on the person tables; use the routed helpers instead.
+(This file deliberately never spells out a violation literally, so it does not
+flag itself.)
+
+Usage (run from the repository root):
+    python3 .standards/s1_person_orm.py report             # JSON list of violations per file
+    python3 .standards/s1_person_orm.py gate               # exit 1 if worse than the baseline
+    python3 .standards/s1_person_orm.py campaign           # progress toward zero
+    python3 .standards/s1_person_orm.py update-baseline    # rewrite the baseline (only allowed to go down)
+
+Standard library only, so it runs on a bare CI runner.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path, PurePosixPath
+
+# --- The standard -----------------------------------------------------------
+# Models whose `<Model>.objects` manager must not be used directly.
+MODELS = ["Person", "PersonDistinctId", "CohortPeople", "Group", "GroupTypeMapping"]
+
+# Files that are allowed to query these tables (paths from repo root), with the reason.
+EXEMPT_FILES = {
+    "posthog/models/person/util.py": "routed helper",
+    "posthog/models/group_type_mapping.py": "routed helper",
+    "posthog/models/person/person.py": "the model module; its managers back the routed helpers",
+}
+
+# Directory names that mark test code anywhere in a path.
+TEST_DIRS = {"test", "tests"}
+# ----------------------------------------------------------------------------
+
+PATTERN = re.compile(r"\b(?:" + "|".join(re.escape(m) for m in MODELS) + r")\.objects\b")
+
+ROOT = Path(__file__).resolve().parent.parent
+BASELINE = ROOT / ".standards" / "s1-baseline.json"
+# Fixed starting point of the campaign. The ratchet baseline shrinks as it is
+# tightened; this does not, so percent done measures the whole campaign.
+CAMPAIGN_START = ROOT / ".standards" / "s1-campaign-start.json"
+
+
+def is_exempt(path: str) -> bool:
+    p = PurePosixPath(path)
+    if path in EXEMPT_FILES:
+        return True
+    if any(part in TEST_DIRS for part in p.parts[:-1]):
+        return True
+    name = p.name
+    return name == "conftest.py" or name.startswith("test_") or name.endswith("_test.py")
+
+
+def python_files() -> list[str]:
+    """Tracked plus untracked-but-not-ignored .py files in the working tree."""
+    out = subprocess.run(
+        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", "*.py"],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+    ).stdout.decode()
+    return sorted({f for f in out.split("\0") if f and (ROOT / f).is_file()})
+
+
+def scan() -> dict[str, int]:
+    counts: dict[str, int] = {}
+    for f in python_files():
+        if is_exempt(f):
+            continue
+        text = (ROOT / f).read_text(encoding="utf-8", errors="replace")
+        n = len(PATTERN.findall(text))
+        if n:
+            counts[f] = n
+    return counts
+
+
+def as_list(counts: dict[str, int]) -> list[dict]:
+    return [{"file": f, "count": n} for f, n in sorted(counts.items())]
+
+
+def load_baseline() -> dict[str, int]:
+    if not BASELINE.exists():
+        return {}
+    return {e["file"]: e["count"] for e in json.loads(BASELINE.read_text())}
+
+
+def write_baseline(counts: dict[str, int]) -> None:
+    BASELINE.write_text(json.dumps(as_list(counts), indent=2) + "\n")
+
+
+def cmd_report(_: argparse.Namespace) -> int:
+    print(json.dumps(as_list(scan()), indent=2))
+    return 0
+
+
+def cmd_gate(_: argparse.Namespace) -> int:
+    base, cur = load_baseline(), scan()
+    worse = [(f, base.get(f, 0), n) for f, n in sorted(cur.items()) if n > base.get(f, 0)]
+    better = [(f, b, cur.get(f, 0)) for f, b in sorted(base.items()) if cur.get(f, 0) < b]
+    for f, b, n in worse:
+        kind = "new file with violations" if b == 0 else "more violations than recorded"
+        print(f"FAIL {f}: {n} (baseline {b}) - {kind}")
+    for f, b, n in better:
+        print(f"IMPROVED {f}: {n} (baseline {b})")
+    if worse:
+        print(
+            "\nS1 gate failed: new direct ORM queries on person tables "
+            f"({'/'.join(m + '.objects' for m in MODELS)}).\n"
+            "Use the routed helpers in posthog/models/person/util.py or posthog/models/group_type_mapping.py\n"
+            "(the _personhog_routed() pattern) instead.\n"
+            "See .standards/STANDARD.md."
+        )
+        return 1
+    if better:
+        print(
+            "\nViolations went down. Tighten the baseline and commit it:\n"
+            "    python3 .standards/s1_person_orm.py update-baseline"
+        )
+    print(f"S1 gate passed: {sum(cur.values())} violations (baseline {sum(base.values())}).")
+    return 0
+
+
+def cmd_campaign(args: argparse.Namespace) -> int:
+    base, cur = load_baseline(), scan()
+    b, c = sum(base.values()), sum(cur.values())
+    start = json.loads(CAMPAIGN_START.read_text())["total"] if CAMPAIGN_START.exists() else b
+    done = 100.0 if start == 0 else max(0.0, (start - c) / start * 100)
+    data = {
+        "campaign_start": start,
+        "baseline": b,
+        "current": c,
+        "fixed": start - c,
+        "percent_done": round(done, 1),
+        "baseline_files": len(base),
+        "current_files": len(cur),
+    }
+    if args.json:
+        print(json.dumps(data, indent=2))
+    else:
+        print(f"S1 campaign: start {start}, baseline {b}, current {c}, {data['percent_done']}% done "
+              f"({len(cur)} files still have violations)")
+    return 0
+
+
+def cmd_update_baseline(args: argparse.Namespace) -> int:
+    base, cur = load_baseline(), scan()
+    worse = [f for f, n in cur.items() if n > base.get(f, 0)]
+    if worse and BASELINE.exists() and not args.allow_increase:
+        print("Refusing to raise the baseline for: " + ", ".join(sorted(worse)))
+        print("Fix them, or pass --allow-increase if the standard itself changed (and say why in the PR).")
+        return 1
+    write_baseline(cur)
+    print(f"Wrote {BASELINE.relative_to(ROOT)}: {sum(cur.values())} violations in {len(cur)} files.")
+    return 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    sub.add_parser("report").set_defaults(fn=cmd_report)
+    sub.add_parser("gate").set_defaults(fn=cmd_gate)
+    c = sub.add_parser("campaign")
+    c.add_argument("--json", action="store_true")
+    c.set_defaults(fn=cmd_campaign)
+    u = sub.add_parser("update-baseline")
+    u.add_argument("--allow-increase", action="store_true")
+    u.set_defaults(fn=cmd_update_baseline)
+    args = ap.parse_args()
+    return args.fn(args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
