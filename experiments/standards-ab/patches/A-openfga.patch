+name: standards-module-size
+
+# Go module-size ratchet. See .standards/STANDARD.md.
+on:
+  merge_group:
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  gate:
+    name: Go module size ratchet
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+
+      - name: Gate
+        env:
+          BASE_SHA: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha }}
+        run: python3 .standards/module_size.py gate --base-ref "$BASE_SHA"
+
+      - name: Campaign progress
+        if: always()
+        run: |
+          {
+            echo '### Go module size'
+            echo '```'
+            python3 .standards/module_size.py campaign
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
