+# Coding-standard ratchet (S2: small Rust modules). See .toolbox/STANDARD.md.
+# Fails a pull request when a Rust file over 700 lines grows, or a file crosses 700 lines (including a
+# new file). Shrinking files pass and are listed in the job summary, so the baseline can be tightened.
+name: toolbox-standards
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+  workflow_dispatch:
+    inputs:
+      mode:
+        description: "check (regressions only), ci (also fail when results.json is stale), update or report"
+        default: update
+
+permissions:
+  contents: read
+
+jobs:
+  ratchet:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          persist-credentials: false
+      # Toolbox's report action (D69). Pin it to a commit SHA once the release is mirrored internally.
+      - uses: loganvolkers/toolbox/actions/report@v0.1.1
+        with:
+          toolbox-version: "0.1.1"
+          portal: .toolbox
+          baseline: .toolbox/results.json
+          # check: fail on regressions only. New compliant files and shrinking files don't need a
+          # results.json update in the same PR (run `--update` to tighten the baseline).
+          mode: ${{ inputs.mode || 'check' }}
