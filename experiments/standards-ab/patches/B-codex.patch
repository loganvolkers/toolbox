+# Codex coding standards, enforced (S2: small Rust modules). See .toolbox/STANDARD.md.
+# Run from the repository root: toolbox report .toolbox --baseline .toolbox/results.json
+apiVersion: toolbox.dev/v1alpha1
+
+portal:
+  name: codex
+  title: Codex coding standards
+  owner: group:maintainers
+  toolbox: "0.1"
+
+connectors:
+  - name: sizes
+    package: builtin:runner
+    runtime: in-image
+    config:
+      name: sizes
+      root: .
+      jobs:
+        - name: rust-files # one record per codex-rs/**/*.rs: path, lines, lineNumbers
+          command: [python3, .toolbox/rust-file-lines.py]
+          parse: ndjson
+          kinds: [rust-file]
+    records: [rust-file]
+    refresh: {rust-file: [external_ids]}
+    freshness: {rust-file: 5m}
+
+kinds:
+  - name: RustFile
+    identityFrom: [connector:sizes]
+    fields:
+      path: {type: string}
+      lines: {type: integer}
+      lineNumbers: {type: list, items: integer}
+    sources: {default: [connector:sizes]}
+    map:
+    - from: sizes/rust-file
+      id: "'rust-file:' + record.path"
+      set: "{'path': record.path, 'lines': record.lines, 'lineNumbers': record.lineNumbers}"
+
+scorecards:
+  - name: small-rust-modules
+    kind: RustFile
+    owner: group:maintainers
+    # AGENTS.md: target Rust modules under 500 LoC; past roughly 800 LoC, add new functionality in
+    # a new module. Enforced stricter, at 700 (team decision, 2026-11-21): a violation is a non-test
+    # .rs file under codex-rs/ with more than 700 lines.
+    levels: [bronze]
+    # A new file (or a renamed one) must arrive at or under 700 lines: otherwise it is a regression.
+    ratchet: {newEntitiesAtLeast: bronze}
+    # Exempt: test files (a tests/ directory, tests.rs, *_tests.rs) and the explicit list below.
+    appliesTo: >-
+      !(entity.path.contains('/tests/') || entity.path.endsWith('/tests.rs') ||
+      entity.path.endsWith('_tests.rs') || entity.path in [])
+    rules:
+    - name: at-most-700-lines
+      level: bronze
+      check: entity.lines <= 700
+      # The line count first, then one item per line over 700: the ratchet compares evidence counts,
+      # so growing by one line is a regression and shrinking by one an improvement.
+      evidence: >-
+        [string(entity.lines) + ' lines (limit 700)'] + entity.lineNumbers.filter(n, n > 700).map(n,
+        'line ' + string(n))
+      fix: >-
+        Move code out of this file into a new module until it is at most 700 lines (target 500). Do
+        not add new functionality to it.
+    facets: {summary: public, details: public}
+
+include:
+  # The campaign toward zero violating files, over the files that violated when it started.
+  - campaign.yaml
