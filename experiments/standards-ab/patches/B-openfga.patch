@@ -0,0 +1,46 @@
+# The campaign toward zero Go files over 1,000 lines (docs: .seikika/STANDARD.md). Included by
+# .seikika/seikika.yaml.
+#
+# Campaign scope is frozen: the 15 files that broke the standard when the campaign started
+# (2026-11-21). The ratchet in seikika.yaml stops new violations; this measures paying down the old
+# ones. A file leaves the list only when it is deleted or renamed: then delete its line here too.
+scorecards:
+  - name: small-go-files-campaign
+    kind: GoFile
+    owner: group:maintainers
+    levels: [bronze]
+    appliesTo: >-
+      entity.path in [
+        'cmd/run/run.go',
+        'internal/check/check.go',
+        'internal/graph/check.go',
+        'internal/mocks/mock_storage.go',
+        'pkg/server/server.go',
+        'pkg/server/test/reverse_expand.go',
+        'pkg/storage/postgres/postgres.go',
+        'pkg/storage/sqlcommon/sqlcommon.go',
+        'pkg/storage/sqlite/sqlite.go',
+        'pkg/storage/test/tuples.go',
+        'pkg/typesystem/typesystem.go',
+        'tests/check/check.go',
+        'tests/check/check_ttu.go',
+        'tests/check/check_userset.go',
+        'tests/listobjects/matrix_usersets.go',
+      ]
+    rules:
+    - name: at-most-1000-lines
+      level: bronze
+      check: entity.lines <= 1000
+      evidence: "[string(entity.lines) + ' lines (limit 1000)']"
+      fix: Split this file until it is at most 1,000 lines (target 600).
+    facets: {summary: public, details: public}
+
+campaigns:
+  - name: small-go-files-zero
+    title: Zero Go files over 1,000 lines
+    owner: group:maintainers
+    description: Every Go file that was over 1,000 lines on 2026-11-21 gets to 1,000 or fewer.
+    start: "2026-11-21"
+    targetPercent: 100
+    milestones: [{name: half, targetPercent: 50}]
+    includes: [{scorecard: small-go-files-campaign, atLeast: bronze}]
