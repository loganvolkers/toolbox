+++ b/.seikika/seikika.yaml
@@ -0,0 +1,68 @@
+# OpenFGA coding standards, enforced (small Go files). See .seikika/STANDARD.md.
+# Run from the repository root: seikika report .seikika --baseline .seikika/results.json
+apiVersion: seikika.com/v1alpha1
+
+portal:
+  name: openfga
+  title: OpenFGA coding standards
+  owner: group:maintainers
+  seikika: "0.1"
+
+connectors:
+  - name: sizes
+    package: builtin:runner
+    runtime: in-image
+    config:
+      name: sizes
+      root: .
+      jobs:
+        - name: go-files # one record per **/*.go: path, lines, lineNumbers
+          command: [python3, .seikika/go-file-lines.py]
+          parse: ndjson
+          kinds: [go-file]
+    records: [go-file]
+    refresh: {go-file: [external_ids]}
+    freshness: {go-file: 5m}
+
+kinds:
+  - name: GoFile
+    identityFrom: [connector:sizes]
+    fields:
+      path: {type: string}
+      lines: {type: integer}
+      lineNumbers: {type: list, items: integer}
+    sources: {default: [connector:sizes]}
+    map:
+    - from: sizes/go-file
+      id: "'go-file:' + record.path"
+      set: "{'path': record.path, 'lines': record.lines, 'lineNumbers': record.lineNumbers}"
+
+scorecards:
+  - name: small-go-files
+    kind: GoFile
+    owner: group:maintainers
+    # Target Go files under 600 lines. Enforced at 1,000: a violation is a non-test .go file with
+    # more than 1,000 lines.
+    levels: [bronze]
+    # A new file (or a renamed one) must arrive at or under 1,000 lines: otherwise it is a regression.
+    ratchet: {newEntitiesAtLeast: bronze}
+    # Exempt: Go test files (*_test.go) and the explicit list below.
+    appliesTo: >-
+      !(entity.path.endsWith('_test.go') || entity.path in [])
+    rules:
+    - name: at-most-1000-lines
+      level: bronze
+      check: entity.lines <= 1000
+      # The line count first, then one item per line over 1,000: the ratchet compares evidence
+      # counts, so growing by one line is a regression and shrinking by one an improvement.
+      evidence: >-
+        [string(entity.lines) + ' lines (limit 1000)'] + entity.lineNumbers.filter(n, n > 1000).map(n,
+        'line ' + string(n))
+      fix: >-
+        Move code out of this file into a new file in the same package until it is at most 1,000
+        lines (target 600). Do not add new functionality to it.
+    facets: {summary: public, details: public}
+
+include:
+  # The campaign toward zero violating files, over the files that violated when it started.
+  - campaign.yaml
