index 0000000..b6892df
--- /dev/null
+++ b/.seikika/go-file-lines.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Emit one Seikika connector record per Go file (tracked or untracked, not ignored).
+
+Used by the `sizes` runner job in .seikika/seikika.yaml. It only measures; the standard (threshold,
+exemptions) lives in the manifest. `lineNumbers` lets a rule's evidence hold one item per line over
+the limit, so the ratchet sees a violating file grow or shrink by a single line.
+"""
+import json
+import subprocess
+import sys
+
+paths = subprocess.run(
+    ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", "*.go"],
+    check=True, capture_output=True,
+).stdout.decode().split("\0")
+
+for path in sorted(p for p in paths if p.endswith(".go")):
+    try:
+        with open(path, "rb") as f:
+            lines = len(f.read().splitlines())
+    except FileNotFoundError:  # deleted in the working tree but still in the index
+        continue
+    record = {"type": "record", "kind": "go-file", "externalId": path,
+              "data": {"path": path, "lines": lines, "lineNumbers": list(range(1, lines + 1))}}
+    sys.stdout.write(json.dumps(record, separators=(",", ":")) + "\n")
