@@ -0,0 +1,35 @@
+# Coding-standard ratchet (small Go files). See .seikika/STANDARD.md.
+# Fails a pull request when a non-test Go file over 1,000 lines grows, or a file crosses 1,000 lines (including a
+# new file). Shrinking files pass and are listed in the job summary, so the baseline can be tightened.
+name: seikika-standards
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+  workflow_dispatch:
+    inputs:
+      mode:
+        description: "check (regressions only), ci (also fail when results.json is stale), update or report"
+        default: update
+
+permissions:
+  contents: read
+
+jobs:
+  ratchet:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          persist-credentials: false
+      # Seikika's report action (D69). Pin it to a commit SHA once the release is mirrored internally.
+      - uses: seikika/seikika/actions/report@v0.1.1
+        with:
+          seikika-version: "0.1.1"
+          portal: .seikika
+          baseline: .seikika/results.json
+          # check: fail on regressions only. New compliant files and shrinking files don't need a
+          # results.json update in the same PR (run `--update` to tighten the baseline).
+          mode: ${{ inputs.mode || 'check' }}
