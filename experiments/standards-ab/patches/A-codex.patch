@@ -0,0 +1,34 @@
+name: standards-s2
+
+# S2 small Rust modules ratchet. See .standards/STANDARD.md.
+on:
+  pull_request: {}
+
+permissions:
+  contents: read
+
+jobs:
+  gate:
+    name: S2 module size ratchet
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+
+      - name: Gate
+        env:
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+        run: python3 .standards/s2_module_size.py gate --base-ref "$BASE_SHA"
+
+      - name: Campaign progress
+        if: always()
+        run: |
+          {
+            echo '### S2 small Rust modules'
+            echo '```'
+            python3 .standards/s2_module_size.py campaign
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
