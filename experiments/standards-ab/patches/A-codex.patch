+#!/usr/bin/env python3
+"""S2 (small Rust modules) report, ratchet gate and campaign tracker.
+
+Run from the repository root:
+
+    python3 .standards/s2_module_size.py report            # violating files as JSON
+    python3 .standards/s2_module_size.py gate              # ratchet check (exit 1 on regression)
+    python3 .standards/s2_module_size.py campaign          # progress toward zero violations
+    python3 .standards/s2_module_size.py update-baseline   # rewrite the baseline from the tree
+
+See .standards/STANDARD.md for the rules and how to change them.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+from pathlib import Path, PurePosixPath
+
+HERE = Path(__file__).resolve().parent
+REPO_ROOT = HERE.parent
+CONFIG_PATH = HERE / "s2-config.json"
+BASELINE_PATH = HERE / "s2-baseline.json"
+
+
+def load_json(path: Path) -> dict:
+    with path.open(encoding="utf-8") as f:
+        return json.load(f)
+
+
+def load_config() -> dict:
+    cfg = load_json(CONFIG_PATH)
+    cfg.setdefault("threshold", 800)
+    cfg.setdefault("root", "codex-rs")
+    cfg.setdefault("exempt", {})
+    return cfg
+
+
+def count_lines(data: bytes) -> int:
+    """Every line of the file: newline count, plus an unterminated last line."""
+    n = data.count(b"\n")
+    if data and not data.endswith(b"\n"):
+        n += 1
+    return n
+
+
+def is_test_file(path: str) -> bool:
+    p = PurePosixPath(path)
+    return "tests" in p.parts[:-1] or p.name == "tests.rs" or p.name.endswith("_tests.rs")
+
+
+def list_rs_files(root: str) -> list[str]:
+    """Tracked plus untracked-but-not-ignored .rs files under root, in the working tree."""
+    out = subprocess.run(
+        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", root],
+        cwd=REPO_ROOT, check=True, capture_output=True,
+    ).stdout
+    files = {f for f in out.decode("utf-8").split("\0") if f.endswith(".rs")}
+    return sorted(f for f in files if (REPO_ROOT / f).is_file())
+
+
+def violations(cfg: dict) -> dict[str, int]:
+    """Map of violating file -> line count for the current working tree."""
+    result = {}
+    exempt = cfg["exempt"]
+    for f in list_rs_files(cfg["root"]):
+        if is_test_file(f) or f in exempt:
+            continue
+        n = count_lines((REPO_ROOT / f).read_bytes())
+        if n > cfg["threshold"]:
+            result[f] = n
+    return result
+
+
+def load_baseline() -> dict:
+    if not BASELINE_PATH.exists():
+        sys.exit(f"error: no baseline at {BASELINE_PATH.relative_to(REPO_ROOT)}; "
+                 "run `python3 .standards/s2_module_size.py update-baseline`")
+    return load_json(BASELINE_PATH)
+
+
+def baseline_at_ref(ref: str) -> dict | None:
+    rel = BASELINE_PATH.relative_to(REPO_ROOT).as_posix()
+    r = subprocess.run(["git", "show", f"{ref}:{rel}"], cwd=REPO_ROOT, capture_output=True)
+    if r.returncode != 0:
+        return None
+    return json.loads(r.stdout)
+
+
+def cmd_report(args, cfg) -> int:
+    v = violations(cfg)
+    rows = [{"file": f, "lines": n} for f, n in sorted(v.items(), key=lambda kv: (-kv[1], kv[0]))]
+    print(json.dumps(rows, indent=2))
+    return 0
+
+
+def cmd_gate(args, cfg) -> int:
+    base = load_baseline()
+    threshold = cfg["threshold"]
+    failures, notes = [], []
+
+    if base.get("threshold") != threshold:
+        failures.append(f"baseline was recorded at threshold {base.get('threshold')} but the config "
+                        f"says {threshold}; run update-baseline and commit it with the config change")
+
+    allowed: dict[str, int] = base.get("files", {})
+    current = violations(cfg)
+
+    for f, n in sorted(current.items()):
+        if f not in allowed:
+            failures.append(f"NEW VIOLATION {f}: {n} lines (limit {threshold}); split it into modules")
+        elif n > allowed[f]:
+            failures.append(f"GREW {f}: {allowed[f]} -> {n} lines (+{n - allowed[f]}); "
+                            "add new functionality in a new module instead")
+        elif n < allowed[f]:
+            notes.append(f"SHRANK {f}: {allowed[f]} -> {n} lines")
+    for f, n in sorted(allowed.items()):
+        if f not in current:
+            path = REPO_ROOT / f
+            if not path.is_file():
+                notes.append(f"FIXED {f}: removed or renamed (was {n} lines)")
+            elif f in cfg["exempt"]:
+                notes.append(f"FIXED {f}: now exempt in s2-config.json (was {n} lines)")
+            else:
+                now = count_lines(path.read_bytes())
+                notes.append(f"FIXED {f}: {n} -> {now} lines, at or under {threshold}")
+
+    # The baseline itself must only tighten relative to the base branch.
+    if args.base_ref:
+        old = baseline_at_ref(args.base_ref)
+        if old is not None:
+            old_files = old.get("files", {})
+            for f, n in sorted(allowed.items()):
+                if f not in old_files:
+                    failures.append(f"BASELINE LOOSENED: {f} added to the baseline ({n} lines)")
+                elif n > old_files[f]:
+                    failures.append(f"BASELINE LOOSENED: {f} raised {old_files[f]} -> {n}")
+
+    tightenable = bool(notes)
+    if args.base_ref and baseline_at_ref(args.base_ref) is None:
+        notes.append(f"no baseline at {args.base_ref}; skipped the baseline-loosening check")
+    for line in notes:
+        print(f"note: {line}")
+    if tightenable:
+        print("note: the baseline can be tightened: "
+              "python3 .standards/s2_module_size.py update-baseline")
+    for line in failures:
+        print(f"FAIL: {line}")
+    if failures:
+        print(f"S2 gate failed: {len(failures)} problem(s). See .standards/STANDARD.md.")
+        return 1
+    print(f"S2 gate passed: {len(current)} violating file(s), none grew, none new "
+          f"(baseline {len(allowed)}).")
+    return 0
+
+
+def cmd_campaign(args, cfg) -> int:
+    base = load_baseline()
+    # Measure against the campaign start so that tightening the baseline keeps the progress.
+    base_n = base.get("campaign_start", len(base.get("files", {})))
+    cur = violations(cfg)
+    cur_n = len(cur)
+    pct = 100.0 if base_n == 0 else max(0.0, (base_n - cur_n) / base_n * 100)
+    excess = sum(n - cfg["threshold"] for n in cur.values())
+    data = {"baseline_files": base_n, "current_files": cur_n, "fixed": base_n - cur_n,
+            "percent_done": round(pct, 1), "lines_over_threshold": excess,
+            "threshold": cfg["threshold"]}
+    if args.json:
+        print(json.dumps(data, indent=2))
+    else:
+        print(f"S2 small Rust modules (>{cfg['threshold']} lines)")
+        print(f"baseline: {base_n} files")
+        print(f"current:  {cur_n} files")
+        print(f"done:     {data['percent_done']}% ({data['fixed']} fixed, {cur_n} to go)")
+        print(f"excess:   {excess} lines over the threshold in violating files")
+    return 0
+
+
+def cmd_update_baseline(args, cfg) -> int:
+    cur = violations(cfg)
+    data = {"standard": "S2 small Rust modules", "threshold": cfg["threshold"],
+            "files": dict(sorted(cur.items()))}
+    if BASELINE_PATH.exists() and "campaign_start" in (old := load_json(BASELINE_PATH)):
+        data["campaign_start"] = old["campaign_start"]
+    else:
+        data["campaign_start"] = len(cur)
+    BASELINE_PATH.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
+    print(f"wrote {BASELINE_PATH.relative_to(REPO_ROOT)}: {len(cur)} file(s)")
+    return 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    sub.add_parser("report", help="print violating files as JSON")
+    g = sub.add_parser("gate", help="fail if the ratchet is broken")
+    g.add_argument("--base-ref", help="also fail if the baseline loosened relative to this git ref")
+    c = sub.add_parser("campaign", help="print progress toward zero violations")
+    c.add_argument("--json", action="store_true", help="machine-readable output")
+    sub.add_parser("update-baseline", help="rewrite the baseline from the working tree")
+    args = ap.parse_args()
+    cfg = load_config()
+    return {"report": cmd_report, "gate": cmd_gate, "campaign": cmd_campaign,
+            "update-baseline": cmd_update_baseline}[args.cmd](args, cfg)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
