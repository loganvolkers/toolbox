diff --git a/.github/workflows/pull_request.yaml b/.github/workflows/pull_request.yaml
index a145c07..bed4e03 100644
--- a/.github/workflows/pull_request.yaml
+++ b/.github/workflows/pull_request.yaml
@@ -28,6 +28,22 @@ jobs:
           version: latest
           args: -v -c .golangci.yaml
 
+  pr-summary:
+    runs-on: ubuntu-latest
+    needs: lint
+    timeout-minutes: 5
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          persist-credentials: false
+      - name: Write PR summary
+        env:
+          PR_TITLE: ${{ github.event.pull_request.title }}
+        run: |
+          echo "## ${PR_TITLE}" >> "$GITHUB_STEP_SUMMARY"
+          git log -1 --format=%s >> "$GITHUB_STEP_SUMMARY"
+
   # Fast unit tests — all packages except storage backends and integration tests
   tests-unit:
     runs-on: ubuntu-latest-4-cores
