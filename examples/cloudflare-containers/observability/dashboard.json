{
  "uid": "seikika-runtime",
  "title": "Seikika runtime",
  "schemaVersion": 40,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "seikika"
  ],
  "links": [
    {
      "title": "Open the demo portal",
      "type": "link",
      "url": "https://demo.seikika.com/",
      "targetBlank": true
    },
    {
      "title": "Guest walkthrough",
      "type": "link",
      "url": "https://seikika.com/demo/observability/",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Snapshot lag",
      "description": "Seconds since the last published snapshot. Age grows between publications. Compare it with connector ingestion and the expected refresh cadence.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "seikika_snapshot_lag_seconds{service_name=\"seikika-demo\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Connector records and batches",
      "description": "Cumulative counters since the portal process started. A restart can reset either counter.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "seikika_ingest_records_total{service_name=\"seikika-demo\"}",
          "legendFormat": "Records"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "seikika_ingest_batches_total{service_name=\"seikika-demo\"}",
          "legendFormat": "Batches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Request rate by outcome",
      "description": "Requests per second for instrumented demo routes. An ERROR span indicates a server-side 5xx.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status_code) (rate(traces_spanmetrics_calls_total{service=\"seikika-demo\",span_name=\"http.server.request\"}[$__rate_interval]))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "95th-percentile request latency",
      "description": "Server span duration for the demo routes. Sparse traffic makes this percentile unstable.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"seikika-demo\",span_name=\"http.server.request\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Recent request logs",
      "description": "Expand a request to copy its trace_id, then select the matching Trace ID in the traces table. Refresh the demo portal to generate a new event.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"seikika-demo\"} | line_format \"{{.http_request_method}} {{.url_path}} \u2192 {{.status}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "title": "Recent request traces",
      "description": "Open a trace to inspect the response code, server span duration and the linked request log.",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"seikika-demo\" && name = \"http.server.request\" }",
          "limit": 30,
          "tableType": "traces"
        }
      ]
    }
  ]
}
