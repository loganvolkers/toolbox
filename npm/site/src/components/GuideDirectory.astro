---
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';

interface Props {
  section: 'connectors' | 'packages';
  slugs?: string[];
}

const { section, slugs } = Astro.props;
// Landing pages are direct children. Additional guides can live under each entry.
const guides = await getCollection('docs', ({ id, data }) => {
  const slug = id.slice(section.length + 1);
  return id.startsWith(`${section}/`) &&
    /^[a-z0-9-]+$/.test(slug) &&
    (slugs === undefined || slugs.includes(slug)) &&
    !data.draft &&
    !data.sidebar.hidden &&
    Boolean(data.title.trim() && data.description?.trim());
});
guides.sort((a, b) =>
  (a.data.sidebar.order ?? Number.MAX_SAFE_INTEGER) -
    (b.data.sidebar.order ?? Number.MAX_SAFE_INTEGER) ||
  a.data.title.localeCompare(b.data.title, 'en')
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<CardGrid>
  {guides.map(({ id, data }) => (
    <LinkCard href={`${base}/${id}/`} title={data.title} description={data.description} />
  ))}
</CardGrid>
