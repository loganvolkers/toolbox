---
interface Props {
  /** Browser tab title. Defaults to `Seikika report`. */
  title?: string;
}
const { title = "Seikika report" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="seikika-ui">
    <slot />
  </body>
</html>
<style is:global>
  body.seikika-ui { margin: 0; }
</style>
