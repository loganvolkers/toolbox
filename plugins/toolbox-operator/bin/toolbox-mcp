#!/bin/sh
# Launcher for the Toolbox authoring MCP server (stdio).
#
# Pre-release skeleton: the `toolbox` binary does not exist yet. When it does, this launcher will:
#   1. Read the Toolbox version pinned in the workspace's toolbox.lock (workspace is passed per tool call).
#   2. Use a cached, signature-verified binary from the plugin data directory, or fetch and verify it.
#   3. exec `toolbox mcp --dev`.
# It deliberately does not rely on whatever `toolbox` happens to be on PATH.
set -eu

DATA_DIR=""
while [ $# -gt 0 ]; do
  case "$1" in
    --data) DATA_DIR="$2"; shift 2 ;;
    *) shift ;;
  esac
done

if [ -n "${TOOLBOX_BIN:-}" ] && [ -x "${TOOLBOX_BIN}" ]; then
  exec "${TOOLBOX_BIN}" mcp --dev --data "${DATA_DIR}"
fi

echo "toolbox-operator: the Toolbox binary is not available yet (pre-release plugin skeleton)." >&2
exit 1
